# Copy this file to .env and adjust if needed.
# All values below have safe defaults baked into docker-compose.yml,
# so running `docker compose up -d` works out of the box without a .env file.

# MariaDB root password (only used for container initialization)
DB_ROOT_PASSWORD=root

# Application database
DB_NAME=erada
DB_USER=erada
DB_PASSWORD=erada

# Session store database (used by express-mysql-session)
SESSION_DB_NAME=session

# Express session cookie signing secret - change this in production
SESSION_SECRET=change-me-in-production

# Set to true when serving the app over HTTPS behind a reverse proxy
COOKIE_SECURE=false

# Host port the app will be published on (container always listens on 3000)
APP_PUBLISHED_PORT=8080
